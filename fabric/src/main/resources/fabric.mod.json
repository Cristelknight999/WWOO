{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "William Wythers",
        "Cristelknight"
    ],
    "contact": {
        "homepage": "${homepage}"
    },
    "license": "${license}",
    "icon": "pack.png",
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "${discord}"
            }
        }
    },
    "environment": "*",
    "entrypoints": {
        "main": [
            "de.cristelknight.wwoo.WWOO"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_min_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "cristellib": ">=${cristellib_version}",
        "java": ">=${java_version}"
    }
}